[0.009708, "o", "\u001b[H\u001b[J\u001b[3J"]
[0.511818, "o", "\u001b[1;36m# veil phase-2: an agent driving a real browser, fast — not just correct\u001b[0m\r\n"]
[1.513821, "o", "\u001b[1;36m#   old way: goto, snapshot, find target, click, wait, snapshot, extract x2 = 8 MCP calls\u001b[0m\r\n"]
[2.516209, "o", "\u001b[1;36m#   new way: gotoAndWait, one read, ONE veil_batch = 3 calls, same real site\u001b[0m\r\n"]
